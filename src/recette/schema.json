{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arko.app/schema/arko.recette-1.json",
  "title": "Recette de montage Arko (arko.recette/1)",
  "description": "Recette JSON d'un clip vertical TikTok. Temps en secondes (1/100). Dans les plans, de/a sont des temps de la vidéo SOURCE. Durée finale = somme de (a - de) / vit. Le normaliseur d'Arko corrige la plupart des erreurs au lieu de rejeter. Champs du Montage auto (blancs, rognages, musique, volumeFinal, sections, plan.zoomFixe, sousTitres.mode/punchlines, son.role/dur/fondu) : tous facultatifs.",
  "type": "object",
  "required": [
    "format",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arko.recette/1"
    },
    "titre": {
      "type": "string",
      "maxLength": 120
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "mise": {
      "$ref": "#/$defs/mise"
    },
    "textes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/texte"
      }
    },
    "sousTitres": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sousTitres"
        }
      ]
    },
    "sons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/son"
      }
    },
    "zooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoom"
      }
    },
    "guide": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/guide"
        }
      ]
    },
    "boucle": {
      "type": "boolean",
      "default": false
    },
    "marqueurs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marqueur"
      }
    },
    "statut": {
      "enum": [
        "brouillon",
        "garde",
        "jete"
      ]
    },
    "export": {
      "$ref": "#/$defs/export"
    },
    "destination": {
      "enum": [
        "tiktok",
        "youtube",
        "short"
      ],
      "description": "Où sera publiée la vidéo. Absent = tiktok."
    },
    "chapitres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "nom"
        ],
        "additionalProperties": false,
        "properties": {
          "t": {
            "$ref": "#/$defs/temps"
          },
          "nom": {
            "type": "string"
          }
        }
      },
      "description": "Chapitres YouTube, en temps de sortie sans l'intro."
    },
    "intro": {
      "$ref": "#/$defs/generique"
    },
    "outro": {
      "$ref": "#/$defs/generique"
    },
    "blancs": {
      "type": "object",
      "required": [
        "niveau"
      ],
      "additionalProperties": false,
      "description": "A. Les plans viennent de « Couper les blancs ».",
      "properties": {
        "niveau": {
          "enum": [
            "serre",
            "normal",
            "large"
          ]
        },
        "fonduEntree": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.2,
          "default": 0.02
        },
        "fonduSortie": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.2,
          "default": 0.04
        }
      }
    },
    "rognages": {
      "type": "array",
      "description": "D. Partie gardée de chaque source vidéo (0 à 1), sans les bords fixes.",
      "items": {
        "type": "object",
        "required": [
          "src",
          "x",
          "y",
          "l",
          "h"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "l": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          }
        }
      }
    },
    "musique": {
      "type": "object",
      "required": [
        "morceaux"
      ],
      "additionalProperties": false,
      "description": "F. Musique de fond, en temps de sortie, baissée quand on parle.",
      "properties": {
        "morceaux": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "src",
              "t"
            ],
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "description": "Source audio."
              },
              "t": {
                "$ref": "#/$defs/temps"
              },
              "fin": {
                "$ref": "#/$defs/temps"
              },
              "debut": {
                "$ref": "#/$defs/temps"
              },
              "boucle": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.14
        },
        "baisse": {
          "type": "boolean",
          "default": true
        },
        "fonduEntree": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 1.2
        },
        "fonduSortie": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 1.5
        }
      }
    },
    "volumeFinal": {
      "type": "object",
      "additionalProperties": false,
      "description": "F. Volume final visé à l'export.",
      "properties": {
        "lufs": {
          "type": "number",
          "minimum": -30,
          "maximum": -6,
          "default": -14
        },
        "crete": {
          "type": "number",
          "minimum": -6,
          "maximum": -0.1,
          "default": -1.5
        }
      }
    },
    "sections": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "description": "G. Titres de section à l'écran.",
      "properties": {
        "source": {
          "enum": [
            "chapitres",
            "main"
          ]
        },
        "son": {
          "type": "boolean",
          "default": true
        },
        "dur": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6,
          "default": 2.2
        }
      }
    },
    "amelioration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Améliorer l'image (facultatif ; absent = Non). Nettoie la compression et agrandit x2 sur l'appareil (réseaux CNN d'Anime4K, licence MIT ; repli sans IA si la carte graphique ne suit pas). Le normaliseur accepte aussi true (= leger) ou le niveau seul en texte.",
      "properties": {
        "niveau": {
          "enum": [
            "leger",
            "fort"
          ],
          "default": "leger"
        },
        "nettoyer": {
          "type": "boolean",
          "default": true,
          "description": "Nettoyer la compression."
        },
        "agrandir": {
          "type": "boolean",
          "default": true,
          "description": "Agrandir avec l'IA (x2, seulement si l'image est agrandie à l'écran)."
        }
      }
    },
    "incrustations": {
      "type": "array",
      "maxItems": 30,
      "description": "Ma bibliothèque (facultatif) : fonds verts et mèmes posés PAR-DESSUS la vidéo, en temps de sortie. Un mème « Coupure » est un plan ordinaire dont la source a « bib ».",
      "items": {
        "$ref": "#/$defs/incrustation"
      }
    },
    "personnes": {
      "type": "array",
      "maxItems": 8,
      "description": "v3 (facultatif) : les personnes qui parlent et leur chibi.",
      "items": {
        "$ref": "#/$defs/personne"
      }
    },
    "paroles": {
      "type": "array",
      "maxItems": 20000,
      "description": "v3 (facultatif) : qui parle quand.",
      "items": {
        "$ref": "#/$defs/tourDeParole"
      }
    },
    "avatars": {
      "type": "object",
      "additionalProperties": false,
      "description": "v3 (facultatif) : avatar de la personne qui parle.",
      "properties": {
        "mode": {
          "enum": [
            "parle",
            "toujours"
          ]
        },
        "rebond": {
          "type": "boolean"
        },
        "tenue": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "style": {
          "enum": [
            "feutre",
            "crayon",
            "paint",
            "bd",
            "cartoon",
            "rate",
            "mascotte",
            "pixel",
            "papier"
          ]
        }
      }
    },
    "derush": {
      "type": "object",
      "required": [
        "passages"
      ],
      "additionalProperties": false,
      "description": "v3 (facultatif) : passages notés mais pas gardés.",
      "properties": {
        "passages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/passage"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 50,
      "description": "v3 (facultatif) : images fixes insérées (le fichier reste sur l'appareil).",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "pistesAudio": {
      "type": "array",
      "description": "v3 (facultatif) : pistes audio mixées d'une vidéo à plusieurs pistes.",
      "items": {
        "type": "object",
        "required": [
          "src",
          "pistes"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "pistes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "n"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 0
                },
                "vol": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.5
                },
                "nom": {
                  "type": "string",
                  "maxLength": 24
                }
              }
            }
          }
        }
      }
    },
    "bips": {
      "type": "object",
      "required": [
        "son"
      ],
      "additionalProperties": false,
      "description": "v3 (facultatif) : bip ou silence sur les gros mots.",
      "properties": {
        "son": {
          "enum": [
            "bip",
            "muet"
          ]
        }
      }
    }
  },
  "$defs": {
    "temps": {
      "description": "Secondes (nombre), ou chaîne \"12,5\" / \"2:14.5\" / \"1:02:14,5\".",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(:\\d{1,2}){0,2}([.,]\\d+)?s?$"
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "\"s1\", \"g1\"…"
        },
        "nom": {
          "type": "string"
        },
        "taille": {
          "type": "integer",
          "minimum": 0
        },
        "emp": {
          "type": "string",
          "description": "Empreinte du fichier."
        },
        "duree": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "enum": [
            "video",
            "audio"
          ]
        },
        "l": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "bib": {
          "type": "string",
          "description": "Clip de Ma bibliothèque (fond vert, mème) : son identifiant sur l'appareil. Le fichier n'est jamais copié dans le montage."
        },
        "pistes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16,
          "description": "v3 : nombre de pistes audio (seulement s'il y en a au moins 2)."
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "de",
        "a"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "description": "Défaut : première source vidéo."
        },
        "de": {
          "$ref": "#/$defs/temps",
          "description": "Début, temps source."
        },
        "a": {
          "$ref": "#/$defs/temps",
          "description": "Fin, temps source (au moins 0,10 s après de)."
        },
        "vit": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4,
          "default": 1
        },
        "trans": {
          "description": "Transition pour ENTRER dans ce plan (ignorée sur le premier).",
          "oneOf": [
            {
              "$ref": "#/$defs/typeTransition"
            },
            {
              "$ref": "#/$defs/transition"
            }
          ]
        },
        "mise": {
          "$ref": "#/$defs/mise"
        },
        "m": {
          "type": "string",
          "description": "Id du moment d'origine (ARKO-MOMENTS)."
        },
        "fige": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 5,
          "description": "Arrêt sur image : la dernière image du plan reste figée pendant ces secondes, sans son. Durée du plan = (a − de) / vit + fige."
        },
        "zoomFixe": {
          "type": "object",
          "required": [
            "force"
          ],
          "additionalProperties": false,
          "description": "C. Zoom tenu sur tout le plan.",
          "properties": {
            "force": {
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.45
            }
          }
        },
        "ins": {
          "$ref": "#/$defs/elementInsere"
        }
      }
    },
    "typeTransition": {
      "enum": [
        "coupe",
        "fondu",
        "noir",
        "flash",
        "whoosh",
        "glisse",
        "zoom"
      ]
    },
    "transition": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/typeTransition"
        },
        "dur": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.6,
          "default": 0.3
        },
        "son": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        }
      }
    },
    "cadre": {
      "type": "object",
      "required": [
        "x",
        "y",
        "l",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "l": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        }
      }
    },
    "mise": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Vidéo entière ajustée à la largeur + fond flou. y = centre vertical.",
          "properties": {
            "type": {
              "const": "flou"
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Plein écran 9:16 recadré. x = centre horizontal du cadrage dans la source.",
          "properties": {
            "type": {
              "const": "recadre"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Jeu + webcam (phase 2). cam = rectangle de la webcam dans la source.",
          "properties": {
            "type": {
              "const": "jeuCam"
            },
            "cam": {
              "$ref": "#/$defs/cadre"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "camEnHaut": {
              "type": "boolean",
              "default": true
            },
            "partCam": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 0.6,
              "default": 0.42
            }
          }
        }
      ]
    },
    "texte": {
      "type": "object",
      "required": [
        "txt",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "txt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Les émojis ne sont pas dessinés (retirés au rendu). Retour à la ligne automatique, 3 lignes au plus."
        },
        "role": {
          "enum": [
            "accroche",
            "top3",
            "section"
          ],
          "description": "accroche = texte d'accroche du début (posé par l'outil Accroche) ; top3 = numéro posé par le modèle Top 3. ; section = titre de section (Montage auto)."
        },
        "style": {
          "enum": [
            "accroche",
            "bulle",
            "citron",
            "alerte",
            "discret",
            "bandeau"
          ],
          "default": "accroche",
          "description": "accroche = gros titre blanc à contour noir ; bulle = noir sur fond blanc ; citron = sur fond vert citron ; alerte = jaune penché ; discret = petit, blanc avec ombre. Inconnu → accroche."
        },
        "t": {
          "$ref": "#/$defs/temps",
          "description": "Temps de SORTIE. Un texte à t = 0 est visible entier dès la 1re image (accroche : 0 à 2,5 s)."
        },
        "dur": {
          "type": "number",
          "minimum": 0.3,
          "default": 3
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.62,
          "default": 0.2
        }
      }
    },
    "mot": {
      "type": "array",
      "description": "[texte, début source, fin source, mis en valeur (0/1)]",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "enum": [
            0,
            1
          ]
        }
      ],
      "minItems": 3,
      "maxItems": 4
    },
    "sousTitres": {
      "type": "object",
      "required": [
        "mots"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "karaoke",
            "pop",
            "boite",
            "punchline"
          ],
          "default": "karaoke",
          "description": "karaoke = mot en cours en citron ; pop = un mot à la fois, en gros ; boite = fond noir. Inconnu → karaoke."
        },
        "y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.72,
          "description": "Centre vertical. Défaut selon la mise en page : flou 0,66 ; recadre 0,60 ; jeuCam sur la jointure des deux bandes."
        },
        "src": {
          "type": "string"
        },
        "parLigne": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 3,
          "description": "Mots par ligne. Une ligne s'arrête aussi sur un trou de plus de 0,6 s ou une fin de phrase."
        },
        "mots": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mot"
              }
            }
          ]
        },
        "mode": {
          "enum": [
            "tout",
            "punchlines"
          ],
          "default": "tout",
          "description": "B. punchlines = seules les phrases fortes s'affichent."
        },
        "punchlines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ts",
              "fin"
            ],
            "additionalProperties": false,
            "properties": {
              "ts": {
                "$ref": "#/$defs/temps"
              },
              "fin": {
                "$ref": "#/$defs/temps"
              }
            }
          }
        },
        "couleurCle": {
          "enum": [
            "jaune",
            "rouge"
          ],
          "default": "jaune"
        },
        "jurons": {
          "enum": [
            "masques",
            "visibles"
          ],
          "default": "masques"
        },
        "pour": {
          "type": "string",
          "maxLength": 12,
          "description": "Best-of : id d'une personne dont toutes les phrases sont sous-titrées (boîte, en bas) en plus des punchlines."
        }
      }
    },
    "son": {
      "type": "object",
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "ts"
          ]
        },
        {
          "required": [
            "t"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Id du catalogue (\"impact.boom\")."
        },
        "t": {
          "$ref": "#/$defs/temps",
          "description": "Temps de sortie."
        },
        "ts": {
          "$ref": "#/$defs/temps",
          "description": "Temps source (prioritaire)."
        },
        "src": {
          "type": "string"
        },
        "vol": {
          "type": "number",
          "minimum": 0,
