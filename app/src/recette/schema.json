{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arko.app/schema/arko.recette-1.json",
  "title": "Recette de montage Arko (arko.recette/1)",
  "description": "Recette JSON d'un clip vertical TikTok. Temps en secondes (1/100). Dans les plans, de/a sont des temps de la vidéo SOURCE. Durée finale = somme de (a - de) / vit. Le normaliseur d'Arko corrige la plupart des erreurs au lieu de rejeter.",
  "type": "object",
  "required": [
    "format",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arko.recette/1"
    },
    "titre": {
      "type": "string",
      "maxLength": 120
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "mise": {
      "$ref": "#/$defs/mise"
    },
    "textes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/texte"
      }
    },
    "sousTitres": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sousTitres"
        }
      ]
    },
    "sons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/son"
      }
    },
    "zooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoom"
      }
    },
    "guide": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/guide"
        }
      ]
    },
    "boucle": {
      "type": "boolean",
      "default": false
    },
    "marqueurs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marqueur"
      }
    },
    "statut": {
      "enum": [
        "brouillon",
        "garde",
        "jete"
      ]
    },
    "export": {
      "$ref": "#/$defs/export"
    }
  },
  "$defs": {
    "temps": {
      "description": "Secondes (nombre), ou chaîne \"12,5\" / \"2:14.5\" / \"1:02:14,5\".",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(:\\d{1,2}){0,2}([.,]\\d+)?s?$"
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "\"s1\", \"g1\"…"
        },
        "nom": {
          "type": "string"
        },
        "taille": {
          "type": "integer",
          "minimum": 0
        },
        "emp": {
          "type": "string",
          "description": "Empreinte du fichier."
        },
        "duree": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "enum": [
            "video",
            "audio"
          ]
        },
        "l": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "de",
        "a"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "description": "Défaut : première source vidéo."
        },
        "de": {
          "$ref": "#/$defs/temps",
          "description": "Début, temps source."
        },
        "a": {
          "$ref": "#/$defs/temps",
          "description": "Fin, temps source (au moins 0,10 s après de)."
        },
        "vit": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4,
          "default": 1
        },
        "trans": {
          "description": "Transition pour ENTRER dans ce plan (ignorée sur le premier).",
          "oneOf": [
            {
              "$ref": "#/$defs/typeTransition"
            },
            {
              "$ref": "#/$defs/transition"
            }
          ]
        },
        "mise": {
          "$ref": "#/$defs/mise"
        },
        "m": {
          "type": "string",
          "description": "Id du moment d'origine (ARKO-MOMENTS)."
        },
        "fige": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 5,
          "description": "Arrêt sur image : la dernière image du plan reste figée pendant ces secondes, sans son. Durée du plan = (a − de) / vit + fige."
        }
      }
    },
    "typeTransition": {
      "enum": [
        "coupe",
        "fondu",
        "noir",
        "flash",
        "whoosh",
        "glisse",
        "zoom"
      ]
    },
    "transition": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/typeTransition"
        },
        "dur": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.6,
          "default": 0.3
        },
        "son": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        }
      }
    },
    "cadre": {
      "type": "object",
      "required": [
        "x",
        "y",
        "l",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "l": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        }
      }
    },
    "mise": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Vidéo entière ajustée à la largeur + fond flou. y = centre vertical.",
          "properties": {
            "type": {
              "const": "flou"
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Plein écran 9:16 recadré. x = centre horizontal du cadrage dans la source.",
          "properties": {
            "type": {
              "const": "recadre"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Jeu + webcam (phase 2). cam = rectangle de la webcam dans la source.",
          "properties": {
            "type": {
              "const": "jeuCam"
            },
            "cam": {
              "$ref": "#/$defs/cadre"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "camEnHaut": {
              "type": "boolean",
              "default": true
            },
            "partCam": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 0.6,
              "default": 0.35
            }
          }
        }
      ]
    },
    "texte": {
      "type": "object",
      "required": [
        "txt",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "txt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Les émojis ne sont pas dessinés (retirés au rendu). Retour à la ligne automatique, 3 lignes au plus."
        },
        "role": {
          "enum": ["accroche", "top3"],
          "description": "accroche = texte d'accroche du début (posé par l'outil Accroche) ; top3 = numéro posé par le modèle Top 3."
        },
        "style": {
          "enum": [
            "accroche",
            "bulle",
            "citron",
            "alerte",
            "discret"
          ],
          "default": "accroche",
          "description": "accroche = gros titre blanc à contour noir ; bulle = noir sur fond blanc ; citron = sur fond vert citron ; alerte = jaune penché ; discret = petit, blanc avec ombre. Inconnu → accroche."
        },
        "t": {
          "$ref": "#/$defs/temps",
          "description": "Temps de SORTIE. Un texte à t = 0 est visible entier dès la 1re image (accroche : 0 à 2,5 s)."
        },
        "dur": {
          "type": "number",
          "minimum": 0.3,
          "default": 3
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.62,
          "default": 0.2
        }
      }
    },
    "mot": {
      "type": "array",
      "description": "[texte, début source, fin source, mis en valeur (0/1)]",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "enum": [
            0,
            1
          ]
        }
      ],
      "minItems": 3,
      "maxItems": 4
    },
    "sousTitres": {
      "type": "object",
      "required": [
        "mots"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "karaoke",
            "pop",
            "boite"
          ],
          "default": "karaoke",
          "description": "karaoke = mot en cours en citron ; pop = un mot à la fois, en gros ; boite = fond noir. Inconnu → karaoke."
        },
        "y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.72,
          "description": "Centre vertical. Défaut selon la mise en page : flou 0,66 ; recadre 0,60 ; jeuCam sur la jointure des deux bandes."
        },
        "src": {
          "type": "string"
        },
        "parLigne": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 3,
          "description": "Mots par ligne. Une ligne s'arrête aussi sur un trou de plus de 0,6 s ou une fin de phrase."
        },
        "mots": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mot"
              }
            }
          ]
        }
      }
    },
    "son": {
      "type": "object",
      "required": [
        "id"
      ],
      "anyOf": [
        {
          "required": [
            "ts"
          ]
        },
        {
          "required": [
            "t"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Id du catalogue (\"impact.boom\")."
        },
        "t": {
          "$ref": "#/$defs/temps",
          "description": "Temps de sortie."
        },
        "ts": {
          "$ref": "#/$defs/temps",
          "description": "Temps source (prioritaire)."
        },
        "src": {
          "type": "string"
        },
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "default": 0.8
        }
      }
    },
    "zoom": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "ts"
          ]
        },
        {
          "required": [
            "t"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "$ref": "#/$defs/temps"
        },
        "ts": {
          "$ref": "#/$defs/temps"
        },
        "src": {
          "type": "string"
        },
        "dur": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5,
          "default": 0.6
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "force": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5,
          "default": 1.3
        },
        "style": {
          "enum": [
            "punch",
            "doux"
          ],
          "default": "punch"
        }
      }
    },
    "guide": {
      "type": "object",
      "required": [
        "src"
      ],
      "additionalProperties": false,
      "description": "Son guide : joué dans l'aperçu, jamais exporté.",
      "properties": {
        "src": {
          "type": "string"
        },
        "t": {
          "type": "number",
          "minimum": 0
        },
        "debut": {
          "type": "number",
          "minimum": 0
        },
        "vol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        }
      }
    },
    "marqueur": {
      "type": "object",
      "required": [
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "ts": {
          "type": "number",
          "minimum": 0
        },
        "src": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "h": {
          "enum": [
            1920,
            1280
          ],
          "default": 1920
        },
        "ips": {
          "const": 30
        },
        "qualite": {
          "enum": [
            "normale",
            "haute"
          ],
          "default": "normale"
        }
      }
    }
  }
}
